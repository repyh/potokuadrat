# --- Core ---
APP_URL=http://localhost:3000

# --- Database (Postgres 16) ---
# Direct connection: no transaction pooler. pg-boss and migrations need it.
DATABASE_URL=postgresql://potokuadrat:potokuadrat@localhost:5432/potokuadrat

# --- Auth (Better Auth) ---
# 32+ random characters, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Google Drive service account ---
# Path to the JSON key. Share the photo folders with the service account email.
GOOGLE_DRIVE_KEY_FILE=./secrets/service-account.json
# Recursive indexing depth cap while listing folders.
DRIVE_INDEX_MAX_DEPTH=5

# --- Thumbnail cache ---
THUMB_CACHE_DIR=.cache/thumbs
THUMB_CACHE_MAX_BYTES=5368709120
THUMB_CACHE_MAX_FILES=200000
# 1 strips APP1 (EXIF/XMP), APP13 (IPTC), and COM from thumbnails; 0 serves them untouched.
STRIP_METADATA=1

# --- SMTP (optional; magic links fall back to manual copy) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Potokuadrat <no-reply@example.com>"

# --- Analytics ---
ANALYTICS_RETENTION_MONTHS=12
